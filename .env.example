# ---------------------------------------------------------------------------
# VANRITI - Environment Configuration
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# Then run: php artisan key:generate
# ---------------------------------------------------------------------------

# Basic application settings
APP_NAME="VANRITI"
# Use "local" for development, "production" on the live server.
# NEVER keep APP_ENV=local with APP_DEBUG=true on a public server.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the base URL the site is reachable at (no trailing slash).
# Used by route()/url() helpers so sitemap & canonical links stay correct.
# Local XAMPP example: http://localhost/vanriti
# Production example: https://vanriti.com
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Trusted proxies & hosts (required in production behind a reverse proxy/CDN)
# Leave empty for local development - no behaviour change when empty.
# TRUSTED_PROXIES: comma-separated IPs of nginx/Cloudflare/etc. Enables HTTPS
# scheme detection and real client IPs for rate limiting.
# TRUSTED_HOSTS: comma-separated hostnames allowed to reach the app. When empty,
# the APP_URL host and its subdomains are trusted. Defaults to trusting APP_URL.
# ---------------------------------------------------------------------------
TRUSTED_PROXIES=
TRUSTED_HOSTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vanriti
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session & Cache
# "database" and "file" both work on shared hosting (no Redis needed).
# Keep SESSION_DRIVER=database and CACHE_STORE=database (recommended),
# or switch either to "file" if preferred.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=vanriti

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail (used for order/notification emails via SMTP on production)
# local: MAIL_MAILER=log writes emails to storage/logs instead of sending.
# production SMTP example:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_USERNAME=you@vanriti.com
#   MAIL_PASSWORD=your-smtp-password
#   MAIL_ENCRYPTION=ssl
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@vanriti.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Razorpay (online payments - optional; COD is always available)
# Create keys at https://dashboard.razorpay.com -> Settings -> API Keys
# Leave blank if you only want COD.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Admin seeder credentials
# RolesAndPermissionsSeeder enforces these values when running
#   php artisan db:seed --class=RolesAndPermissionsSeeder
# (or the full php artisan:migrate --seed). Set a strong password.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@vanriti.com
ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to disable
# the GTM bootstrap on the storefront.
GTM_CONTAINER_ID=

# Meta Conversions API (server-side Purchase). The access token itself is NOT
# stored in .env - it lives in the encrypted `meta_capi_access_token` Settings
# row (admin > Settings > SEO). META_CAPI_API_VERSION defaults to v26.0, the
# current Graph API version (released Jul 29, 2026); re-verify before deploy.
META_CAPI_ENABLED=false
META_CAPI_API_VERSION=26.0
META_CAPI_TIMEOUT=5
META_CAPI_CONNECT_TIMEOUT=3

# ---------------------------------------------------------------------------
# AWS (only needed if you use S3 for file storage - optional on shared hosting)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Dadi AI (conversational layer)
# ---------------------------------------------------------------------------
# Provider abstraction currently supports OpenAI. OPENAI_API_KEY is a secret;
# never commit a real key. DADI_AI_MODEL defaults to a cheap JSON-capable
# model. These are only placeholders; the conversation engine is inactive
# until a key is configured.
DADI_AI_PROVIDER=openai
DADI_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1
DADI_AI_TIMEOUT=15
DADI_AI_CONNECT_TIMEOUT=5
DADI_AI_MAX_OUTPUT_TOKENS=900
DADI_AI_MAX_REPLY_LENGTH=600
DADI_AI_TEMPERATURE=0.8
DADI_AI_JSON_MODE=true

VITE_APP_NAME="${APP_NAME}"
